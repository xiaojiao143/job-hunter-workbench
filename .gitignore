# ============================================================
# 求职猎手工作台 · Git 忽略规则
# 原则：**只提交源码**。运行数据、构建产物、缓存、个人备份一律不进仓库。
# ============================================================

# ---------- 运行数据（含真实个人信息，绝不入库） ----------
采集器/data/
采集器/data/**/*
demo-data/*.local.json
*.local.json

# ---------- 个人备份 / 导出 ----------
*.bak
*.bak_*
*.pre*bak
*.prebak
*.mutbak*
.mutbak-trash/
_backup_*/
*_backup/

# ---------- 构建产物 ----------
dist_*/
build/
payload/
*.spec.bak
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
env/
node_modules/

# ---------- 临时 / 调试产物 ----------
_scratch/
_scratch_*/
_评审_*/
_自证_*.log
*.log
*-out.txt
stop-result.txt
task-*.txt
当前自证log名.txt

# ---------- 系统 / 编辑器 ----------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*~

# ---------- 本地环境 ----------
.env
.env.*
*.pem
*.key
token.txt
