# ============================================================
# 求职猎手工作台 · Git 忽略规则
# 原则：**只提交源码**。运行数据、构建产物、缓存、个人备份一律不进仓库。
# ============================================================

# ---------- 运行数据（含真实个人信息，绝不入库） ----------
采集器/data/
采集器/data/**/*
demo-data/*.local.json
*.local.json

# ---------- 个人备份 / 导出 ----------
*.bak
*.bak_*
*.pre*bak
*.prebak
*.mutbak*
.mutbak-trash/
_backup_*/
*_backup/

# ---------- 打包副本：前端部分由 sync_src.py 派生，不入库 ----------
# 这些是「源码的副本」，每次出包前由 `python sync_src.py --apply` 生成，
# 提交它们等于把同一份代码存两遍（约 2.4MB），且容易漂移。
# ⚠️ 手工维护的孪生文件**不在此列**，必须入库：
#    src/server_core.py / src/launcher.py / src/browser_finder.py / src/probe_drission.py
_打包工程/src/js/
_打包工程/src/css/
_打包工程/src/index.html
_打包工程/src/favicon.ico

# ---------- 构建产物 ----------
dist_*/
build/
payload/
*.spec.bak
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
env/
node_modules/

# ---------- 临时 / 调试产物 ----------
_scratch/
_scratch_*/
_评审_*/
_自证_*.log
*.log
*-out.txt
stop-result.txt
task-*.txt
当前自证log名.txt

# ---------- 系统 / 编辑器 ----------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*~

# ---------- 本地环境 ----------
.env
.env.*
*.pem
*.key
token.txt
